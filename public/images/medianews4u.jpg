<!-- show more logo btn script -->
<script>
  const clientsSection = document.getElementById("clientsSection");

const tabBtns = clientsSection.querySelectorAll(".tab-btn");
const cards = clientsSection.querySelectorAll(".client-card");
const viewMoreBtn = document.getElementById("viewMoreBtn");

const ROWS = 4;
const ITEMS_PER_ROW = 4;
const LIMIT = ROWS * ITEMS_PER_ROW;

let expanded = false;
let currentFilter = "new-fmcg";

function renderCards(filter) {

    currentFilter = filter;

    cards.forEach(card => {
        card.classList.remove("show");
    });

    const filteredCards = clientsSection.querySelectorAll("." + filter);

    if (filter === "new-fmcg") {

        if (expanded) {

            filteredCards.forEach(card => card.classList.add("show"));
            viewMoreBtn.textContent = "View Less";

        } else {

            filteredCards.forEach((card, index) => {
                if (index < LIMIT) {
                    card.classList.add("show");
                }
            });

            viewMoreBtn.textContent = "View More";
        }

        viewMoreBtn.style.display =
            filteredCards.length > LIMIT ? "inline-block" : "none";

    } else {

        filteredCards.forEach(card => card.classList.add("show"));
        viewMoreBtn.style.display = "none";
    }
}

tabBtns.forEach(btn => {
    btn.addEventListener("click", function () {

        tabBtns.forEach(b => b.classList.remove("active"));
        this.classList.add("active");

        expanded = false;
        renderCards(this.dataset.filter);
    });
});

viewMoreBtn.addEventListener("click", function () {
    expanded = !expanded;
    renderCards(currentFilter);
});

renderCards("new-fmcg");
</script>


