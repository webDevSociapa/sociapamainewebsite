<style>

/* clients new section */
.section-title h2 {
    font-size: 42px;
    font-weight: 700;
}

.section-title span {
    color: #c8102e;
}

.section-title p {
    max-width: 700px;
    margin: auto;
    color: #666;
}

.client-tabs {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    gap: 6px;
    margin: 30px 0;
    padding: 10px 5px 8px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
}

.client-tabs::-webkit-scrollbar {
    display: none;
}

.tab-btn {
    border: none;
    background: #fff;
    padding: 12px 28px;
    border-radius: 40px;
    cursor: pointer;
    font-weight: 600;
    box-shadow: 0 5px 20px rgba(0,0,0,.08);
    transition: .3s;
    flex: 0 0 auto;
    white-space: nowrap;
}

.tab-btn:hover,
.tab-btn.active {
    background: #d20c0c;
    color: #fff;
    transform: translateY(-3px);
}

.client-grid{
    display:grid;
    grid-template-columns:repeat(4,minmax(0,1fr));
    gap:18px;
}

.client-card{
    background:#fff;
    border-radius:12px;
    padding:18px;
    box-shadow:0 8px 20px rgba(0,0,0,.08);
    text-align:center;
    transition:.35s;
}

.client-card:hover{
    transform:translateY(-8px);
    box-shadow:0 15px 30px rgba(0,0,0,.15);
}

.client-card img{
    width:100%;
    height:70px;
    object-fit:contain;
    transition:.35s;
}

.client-card:hover img{
    transform:scale(1.06);
}

.client-card.hide {
    display: none;
}

#clientsSection .client-card{
    display:none;
}

#clientsSection .client-card.show{
    display:block;
}

#viewMoreBtn{
    display:none;
    margin-top:30px;
    padding: 0px 10px;
}

/* Small Laptop */
@media (min-width:993px) and (max-width:1300px){

    .client-tabs{
        gap:8px;
        justify-content:center;
    }

    .tab-btn{
        padding:10px 16px;
        font-size:13px;
        font-weight:600;
        border-radius:24px;
    }

}

/* Tablet View */
@media (min-width:769px) and (max-width:992px){

    .client-tabs{
        gap:8px;
        justify-content:flex-start;
        flex-wrap:nowrap;
        overflow-x:auto;
        overflow-y:hidden;
        padding-bottom:8px;
        scrollbar-width:none;
        -webkit-overflow-scrolling:touch;
    }

    .client-tabs::-webkit-scrollbar{
        display:none;
    }

    .tab-btn{
        flex:0 0 auto;
        white-space:nowrap;
        padding:9px 14px;
        font-size:12px;
        font-weight:600;
        border-radius:22px;
        min-width:auto;
    }
}

@media (max-width:768px){

    .client-grid{
        grid-template-columns:repeat(4,1fr);
        gap:8px;
    }

    .client-card{
        padding:8px;
        border-radius:8px;
    }

    .client-card img{
        height:34px;
    }

    .client-tabs{
        gap:4px;
        justify-content:flex-start;
        flex-wrap:nowrap;
        overflow-x:auto;
        overflow-y:hidden;
        scrollbar-width:none;
        -webkit-overflow-scrolling:touch;
    }

    .client-tabs::-webkit-scrollbar{
        display:none;
    }

    .tab-btn{
        flex:0 0 auto;
        white-space:nowrap;
        padding:7px 6px;
        font-size:8px;
        font-weight:500;
        border-radius:18px;
        min-width:auto;
    }

    .sociapaVidSec video {
        margin-top: 0%;
    }
}

/* end our client new */

/* ecosytem Section */
.ecosystem-section {
    background: #fff;
}

/* Heading */
.text-red {
    color: #d20c0c;
    font-weight: 700;
}

.text-black {
    color: #363636;
    font-weight: 700;
}

.eco-subtitle {
    color: #666;
    margin-top: 10px;
    line-height: 1.6;
}

/* Whole card clickable */
.eco-card-link{
    display:block;
    text-decoration:none;
    color:inherit;
    height:100%;
}

/* Card */
.eco-card {
    background:#e5e2e285;
    padding:30px;
    border-radius:16px;
    position:relative;
    border:1px solid #eee;
    transition:all .35s ease;
    height:100%;
    overflow:hidden;
}

/* Hover Premium Effect */
.eco-card:hover{
    transform:translateY(-8px);
    box-shadow:0 15px 35px rgba(0,0,0,.10);
    border-color:#d20c0c;
}

/* Logo */
.eco-logo{
    width:auto;
    max-width:170px;
    height:55px;
    object-fit:contain;
    display:block;
    margin-bottom:20px;
}

/* Highlight Card */
.highlight-card{
    border:1px solid rgba(210,12,12,.35);
}

/* Badge */
.badge-tag{
    position:absolute;
    top:15px;
    right:15px;
    background:#f5f5f5;
    color:#555;
    font-size:12px;
    padding:5px 12px;
    border-radius:20px;
}

/* Text */
.eco-card h5{
    margin-top:10px;
    margin-bottom:12px;
    color:#212529;
    font-size:24px;
    font-weight:600;
}

.eco-card p{
    color:#666;
    font-size:15px;
    line-height:1.7;
    margin-bottom:20px;
}

/* Visit Website */
.eco-link{
    color:#d20c0c;
    font-weight:600;
    display:inline-flex;
    align-items:center;
    gap:6px;
    transition:.3s;
}

.eco-card:hover .eco-link{
    letter-spacing:.3px;
}

/* Mobile */
@media(max-width:600px){

    .eco-title{
        font-size:24px;
    }

    .eco-card{
        padding:22px;
        margin-bottom:20px;
    }

    .eco-logo{
        max-width:140px;
        height:45px;
    }

}
/* end ecosystem */

.partnerSec{
  padding:80px 0;
  background:#fff;
}

.partnerRow{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:20px;
}

.partnerCol{
  width:18%;
}

.partnerCard{
  background:#fff;
  border-radius:14px;
  padding:30px 20px;
  display:flex;
  align-items:center;
  justify-content:center;
  border:1px solid #f1f1f1;
  transition:0.3s ease;
  height:140px;
}

.partnerCard:hover{
  transform:translateY(-6px);
}

.partnerLogo{
  max-height:120px;
  width:auto;
  object-fit:contain;
}

/* Tablet */
@media(max-width:992px){
  .partnerCol{
    width:30%;
  }
}

/* Mobile */
@media(max-width:600px){
  .partnerCol{
    width:100%;
  }

  .partnerSec h2 {
    font-size:30px;
  }

  .partnerCard{
    height:120px;
  }
}

/* blogs */
.blog-slider,
.testimonials-slider {
    position: relative;
    padding: 0 50px;
}

.blog-prev,
.blog-next,
.testimonial-prev,
.testimonial-next {
    width: 45px !important;
    height: 45px !important;
    background: #d20c0c;
    border-radius: 50%;
    color: #fff !important;
    box-shadow: 0 4px 15px rgba(0,0,0,.15);
}

.blog-prev:hover,
.blog-next:hover,
.testimonial-prev:hover,
.testimonial-next:hover {
    background: #363636;
}

.blog-prev:after,
.blog-next:after,
.testimonial-prev:after,
.testimonial-next:after {
    font-size: 14px !important;
    font-weight: 700;
}

.blog-pagination .swiper-pagination-bullet-active,
.testimonial-pagination .swiper-pagination-bullet-active {
    background: #d20c0c;
}

.blog-slider .card {
    transition: .3s;
}

.blog-slider .card:hover {
    transform: translateY(-5px);
}

/* Blog Card Content */

.blog-slider .card{
    border-radius: 20px !important;
    overflow: hidden;
}

.blog-slider .card-img-top{
    width: 300px;
    max-width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
    padding: 15px;
    display: block;
    margin: 0 auto;
}

.blog-slider .card-body{
    padding: 10px 20px 25px;
}

.blog-slider .card-body small{
    display: inline-block;
    background: rgba(210,12,12,0.1);
    color: #d20c0c !important;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 15px;
}

.blog-slider .card-title{
    color: #363636;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 15px;

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;

    min-height: 72px;
}

.blog-slider .card-text{
    color: #666 !important;
    font-size: 15px;
    line-height: 1.7;
    margin-bottom: 20px;

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;

    min-height: 50px;
}

.blog-slider .card a{
    color: #d20c0c !important;
    font-weight: 600;
    transition: .3s;
}

.blog-slider .card a:hover{
    color: #363636 !important;
}
/* =========================
   Tablet Devices
========================= */
@media (max-width: 991px) {

    .blog-slider,
    .testimonials-slider {
        padding: 0 30px;
    }

    .blog-prev,
    .blog-next,
    .testimonial-prev,
    .testimonial-next {
        width: 40px !important;
        height: 40px !important;
    }

    .blog-slider .card-img-top {
        width: 220px;
        padding: 12px;
    }

    .blog-slider .card-body {
        padding: 10px 18px 20px;
    }

    .blog-slider .card-title {
        font-size: 18px;
        min-height: 60px;
    }

    .blog-slider .card-text {
        font-size: 14px;
        min-height: 45px;
    }
}


/* =========================
   Mobile Devices
========================= */
@media (max-width: 767px) {

    .blog-slider,
    .testimonials-slider {
        padding: 0 15px;
    }

    /* Move arrows outside the card */
    .blog-prev,
    .blog-next,
    .testimonial-prev,
    .testimonial-next {
        width: 36px !important;
        height: 36px !important;
        top: 45%;
    }

    .blog-prev,
    .testimonial-prev {
        left: -5px;
    }

    .blog-next,
    .testimonial-next {
        right: -5px;
    }

    .blog-prev:after,
    .blog-next:after,
    .testimonial-prev:after,
    .testimonial-next:after {
        font-size: 12px !important;
    }

    .blog-slider .card {
        border-radius: 16px !important;
    }

    .blog-slider .card-img-top {
        width: 180px;
        padding: 15px 15px 5px;
    }

    .blog-slider .card-body {
        padding: 10px 15px 20px;
        text-align: center;
    }

    .blog-slider .card-body small {
        font-size: 11px;
        padding: 4px 10px;
        margin-bottom: 12px;
    }

    .blog-slider .card-title {
        font-size: 16px;
        line-height: 1.4;
        min-height: auto;
        margin-bottom: 12px;
        -webkit-line-clamp: 2;
    }

    .blog-slider .card-text {
        font-size: 14px;
        line-height: 1.6;
        min-height: auto;
        margin-bottom: 15px;
        -webkit-line-clamp: 3;
    }

    .blog-slider .card a {
        font-size: 14px;
    }

    .blog-pagination,
    .testimonial-pagination {
        margin-top: 15px;
    }
}


/* =========================
   Small Mobile Devices
========================= */
@media (max-width: 480px) {

    .blog-slider,
    .testimonials-slider {
        padding: 0 10px;
    }

    .blog-slider .card {
        border-radius: 14px !important;
    }

    .blog-slider .card-img-top {
        width: 150px;
    }

    .blog-slider .card-title {
        font-size: 16px;
    }

    .blog-slider .card-text {
        font-size: 13px;
    }

    .blog-prev,
    .blog-next,
    .testimonial-prev,
    .testimonial-next {
        width: 32px !important;
        height: 32px !important;
    }
}
</style>
